            "color": "#333333"
          },
          "punctuation.delimiter": {
            "color": "#333333"
          },
          "punctuation.bracket": {
            "color": "#333333"
          },
          "markup.heading": {
            "color": "#888888"
          },
          "markup.list": {
            "color": "#333333"
          },
          "markup.bold": {
            "color": "#333333"
          },
          "markup.italic": {
            "color": "#333333"
          },
          "markup.link": {
            "color": "#888888"
          },
          "markup.quote": {
            "color": "#333333"
          },
          "markup.raw": {
            "color": "#444444"
          },
          "markup.highlight": {
            "color": "#555555"
          },
          "tag": {
            "color": "#333333"
          },
