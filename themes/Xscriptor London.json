        "accents": [
          "#777777",
          "#666666",
          "#888888",
          "#444444",
          "#555555",
          "#333333",
          "#777777"
        ],
        "players": [
          {
            "background": "#777777",
            "cursor": "#777777",
            "selection": "#33333326"
          },
          {
            "background": "#666666",
            "cursor": "#666666",
            "selection": "#66666626"
          },
          {
            "background": "#888888",
            "cursor": "#888888",
            "selection": "#88888826"
          },
          {
            "background": "#444444",
            "cursor": "#444444",
            "selection": "#44444426"
          },
          {
            "background": "#555555",
            "cursor": "#555555",
            "selection": "#55555526"
          },
          {
            "background": "#333333",
            "cursor": "#333333",
            "selection": "#33333326"
          },
          {
            "background": "#777777",
            "cursor": "#777777",
            "selection": "#77777726"
          },
          {
            "background": "#888888",
            "cursor": "#888888",
            "selection": "#88888826"
          }
