          },
          "emphasis.italic": {
            "color": "#333333",
            "font_style": "italic"
          },
          "emphasis.underline": {
            "color": "#888888"
          }
        },
        "terminal.background": "#ffffff",
        "terminal.foreground": "#333333",
        "terminal.ansi.background": "#ffffff",
        "terminal.ansi.black": "#ffffff",
        "terminal.ansi.red": "#333333",
        "terminal.ansi.green": "#444444",
        "terminal.ansi.yellow": "#555555",
        "terminal.ansi.blue": "#666666",
        "terminal.ansi.magenta": "#777777",
        "terminal.ansi.cyan": "#888888",
        "terminal.ansi.white": "#333333",
        "terminal.ansi.bright_black": "#333333",
        "terminal.ansi.bright_red": "#444444",
        "terminal.ansi.bright_green": "#555555",
        "terminal.ansi.bright_yellow": "#666666",
        "terminal.ansi.bright_blue": "#777777",
        "terminal.ansi.bright_magenta": "#888888",
        "terminal.ansi.bright_cyan": "#999999",
        "terminal.ansi.bright_white": "#aaaaaa"
