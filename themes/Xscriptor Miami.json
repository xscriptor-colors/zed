        "terminal.ansi.red": "#FF4C8B",
        "terminal.ansi.green": "#7FFFD4",
        "terminal.ansi.yellow": "#FFD84C",
        "terminal.ansi.blue": "#00FFA8",
        "terminal.ansi.magenta": "#D36CFF",
        "terminal.ansi.cyan": "#47CFFF",
        "terminal.ansi.white": "#f7f1ff",
        "terminal.ansi.bright_black": "#69676c",
        "terminal.ansi.bright_red": "#FF4C8B",
        "terminal.ansi.bright_green": "#7FFFD4",
        "terminal.ansi.bright_yellow": "#FFD84C",
        "terminal.ansi.bright_blue": "#00FFA8",
        "terminal.ansi.bright_magenta": "#D36CFF",
