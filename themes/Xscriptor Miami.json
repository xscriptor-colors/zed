            "selection": "#f7f1ff26"
          },
          {
            "background": "#00FFA8",
            "cursor": "#00FFA8",
            "selection": "#00ffa826"
          },
          {
            "background": "#47CFFF",
            "cursor": "#47CFFF",
            "selection": "#47cfff26"
          },
          {
            "background": "#7FFFD4",
            "cursor": "#7FFFD4",
            "selection": "#7fffd426"
          },
          {
            "background": "#FFD84C",
            "cursor": "#FFD84C",
            "selection": "#ffd84c26"
