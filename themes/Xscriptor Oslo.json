          "#8cc265",
          "#d18f52",
          "#e05561",
          "#4dc4ff"
        ],
        "players": [
          {
            "background": "#c162de",
            "cursor": "#c162de",
            "selection": "#abb2bf26"
          },
          {
            "background": "#4aa5f0",
            "cursor": "#4aa5f0",
            "selection": "#4aa5f026"
          },
          {
            "background": "#42b3c2",
            "cursor": "#42b3c2",
            "selection": "#42b3c226"
          },
          {
            "background": "#8cc265",
            "cursor": "#8cc265",
            "selection": "#8cc26526"
          },
          {
            "background": "#d18f52",
            "cursor": "#d18f52",
            "selection": "#d18f5226"
          },
          {
